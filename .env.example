# Copy this to .env and fill in your values.
# Never commit .env to git.

# Supabase (find these in Lovable Cloud → Project Settings → API)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key
# Use pk_test_... for development, pk_live_... for production builds
VITE_PAYMENTS_CLIENT_TOKEN=

# hCaptcha site key (already hardcoded as fallback — only needed to override)
# VITE_HCAPTCHA_SITE_KEY=

# Sentry DSN (already hardcoded as fallback — only needed to override)
# VITE_SENTRY_DSN=
